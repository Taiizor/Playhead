<Page
    x:Class="Playhead.Sample.UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid Padding="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,20"
            FontSize="24"
            FontWeight="Bold"
            Text="Playhead Media Controller" />

        <Border
            Grid.Row="1"
            Margin="0,0,0,20"
            Padding="20"
            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
            CornerRadius="8">
            <StackPanel>
                <TextBlock
                    x:Name="TitleText"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="No Media Selected"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="ArtistText"
                    Margin="0,5,0,0"
                    FontSize="16"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Text="Select a session below"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="80"
                        Margin="0,0,10,0"
                        Click="Prev_Click"
                        Content="⏮ Prev" />
                    <Button
                        Width="80"
                        Margin="0,0,10,0"
                        Click="Play_Click"
                        Content="▶ Play" />
                    <Button
                        Width="80"
                        Margin="0,0,10,0"
                        Click="Pause_Click"
                        Content="⏸ Pause" />
                    <Button
                        Width="80"
                        Click="Next_Click"
                        Content="⏭ Next" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel
            Grid.Row="2"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Text="Active Sessions" />
            <Button
                Margin="15,0,0,0"
                Click="Refresh_Click"
                Content="Refresh" />
        </StackPanel>

        <ListView
            x:Name="SessionsList"
            Grid.Row="3"
            SelectionChanged="SessionsList_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="10">
                        <TextBlock FontWeight="SemiBold" Text="{Binding SourceAppId}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Text="{Binding Title}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>