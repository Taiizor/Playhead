<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
		<TargetFrameworks>$(TargetFrameworks);netstandard1.1;netstandard1.2;netstandard1.3;netstandard1.4;netstandard1.5;netstandard1.6;</TargetFrameworks>
		<TargetFrameworks>$(TargetFrameworks);net45;net46;net461;net462;net47;net471;net472;net48;net481</TargetFrameworks>
		<TargetFrameworks>$(TargetFrameworks);net5.0;net6.0;net7.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<TargetFrameworks>$(TargetFrameworks);netstandard2.0;netstandard2.1</TargetFrameworks>
		<TargetFrameworks>$(TargetFrameworks);netcoreapp3.0;netcoreapp3.1</TargetFrameworks>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
        <DefaultLanguage>en-GB</DefaultLanguage>
        <RootNamespace>Playhead</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

	<!-- NuGet package metadata -->
    <PropertyGroup>
        <ApplicationIcon>Resources\Playhead.ico</ApplicationIcon>
        <Version>1.0.2</Version>
        <AssemblyVersion>$(Version)</AssemblyVersion>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Title>Playhead</Title>
        <PackageId>Playhead</PackageId>
		<Product>Playhead</Product>
        <Authors>Taiizor</Authors>
        <Copyright>Copyright © $([System.DateTime]::Today.ToString(yyyy)) $(Authors)</Copyright>
        <Summary>A modern, highly professional NowPlayingSessionManager (SMTC) wrapper library.</Summary>
        <Description>Playhead is a modern, highly professional C# library that serves as a wrapper around the Windows NowPlayingSessionManager (NPSM) and System Media Transport Controls (SMTC) private APIs. It allows developers to seamlessly interact with media sessions across the system, enabling reading "Now Playing" data (metadata, timeline, playback status) and controlling media playback remotely for supported applications such as Spotify, Chrome, Edge, VLC, and Windows Media Player.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageLicenseExpression></PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReleaseNotes>https://github.com/Taiizor/Playhead/blob/develop/CHANGELOG.md</PackageReleaseNotes>
		<PackageTags>smtc;now-playing;npsm;npsmlib;media;windows;media-controls;playback;transport-controls;dotnet;csharp</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!--<DocumentationFile>..\$(Title)\bin$(OutputPath)\$(Configuration)\$(TargetFramework)\$(Title).xml</DocumentationFile>-->
        <PackageProjectUrl>https://github.com/Taiizor/Playhead</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>git://github.com/Taiizor/Playhead</RepositoryUrl>
        <PackageDescription>$(Description)</PackageDescription>
        <PackageIcon>Playhead.png</PackageIcon>
        <Company>$(Authors)</Company>
        <Owners>$(Authors)</Owners>
        <AnalysisLevel>preview</AnalysisLevel>
        <LangVersion>preview</LangVersion>
        <NeutralLanguage>$(DefaultLanguage)</NeutralLanguage>
        <FileVersion>$(Version)</FileVersion>
        <Configurations>Debug;Release</Configurations>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub">
            <Version>11.0.100-preview.5.26302.115</Version>
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
    </ItemGroup>

	<!-- Symbols & Source Link for a first-class debugging experience when consuming the package -->
	<PropertyGroup>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

    <ItemGroup Condition="$(TargetFramework.StartsWith('netstandard1'))">
        <!-- Pin known-vulnerable transitive dependencies (pulled in by NETStandard.Library for the netstandard1.x targets) to patched versions -->
        <PackageReference Include="System.Net.Http" Version="4.3.4" />
        <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    </ItemGroup>

	<!-- Package assets: README and icon shown on nuget.org -->
    <ItemGroup>
        <None Include="README.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\..\LICENSE">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="Resources\Playhead.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Properties\" />
    </ItemGroup>

</Project>