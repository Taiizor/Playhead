<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>$(TargetFrameworks);netcoreapp3.0;netcoreapp3.1</TargetFrameworks>
		<TargetFrameworks>$(TargetFrameworks);netstandard2.0;netstandard2.1</TargetFrameworks>
		<TargetFrameworks>$(TargetFrameworks);net5.0;net6.0;net7.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<TargetFrameworks>$(TargetFrameworks);net45;net46;net461;net462;net47;net471;net472;net48;net481</TargetFrameworks>
		<TargetFrameworks>$(TargetFrameworks);netstandard1.1;netstandard1.2;netstandard1.3;netstandard1.4;netstandard1.5;netstandard1.6;</TargetFrameworks>
		<LangVersion>preview</LangVersion>
		<AnalysisLevel>preview</AnalysisLevel>
		<Nullable>enable</Nullable>
		<Platforms>AnyCPU;x64;x86</Platforms>
		<Description>A modern, highly professional NowPlayingSessionManager (SMTC) wrapper library.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Authors>Taiizor</Authors>
		<Company>Taiizor</Company>
		<Copyright>Copyright © Taiizor 2026</Copyright>
		<RepositoryUrl>https://github.com/Taiizor/Playhead</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Taiizor/Playhead</PackageProjectUrl>
	</PropertyGroup>

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<!-- NuGet package metadata -->
	<PropertyGroup>
		<Version>1.0.1</Version>
		<PackageId>Playhead</PackageId>
		<Product>Playhead</Product>
		<PackageTags>smtc;now-playing;npsm;npsmlib;media;windows;media-controls;playback;transport-controls;dotnet;csharp</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>Logo.png</PackageIcon>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>https://github.com/Taiizor/Playhead/blob/develop/CHANGELOG.md</PackageReleaseNotes>
	</PropertyGroup>

	<!-- Symbols & Source Link for a first-class debugging experience when consuming the package -->
	<PropertyGroup>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.300" PrivateAssets="All" />

		<!-- Pin known-vulnerable transitive dependencies (pulled in by NETStandard.Library for the netstandard1.x targets) to patched versions -->
		<PackageReference Include="System.Net.Http" Version="4.3.4" />
		<PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
	</ItemGroup>

	<!-- Package assets: README and icon shown on nuget.org -->
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\Logo.png" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>